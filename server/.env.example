# Server Configuration
PORT=3001

# CORS Configuration
# Use * to allow all origins (for development or cross-platform deployment)
# In production, set to specific origins: CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*

# MySQL Configuration
# Railway automatically injects MYSQL_HOST, MYSQL_PORT, MYSQL_USER, MYSQL_PASSWORD, MYSQL_DATABASE
# You can also set your own DB_* variables which take priority
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=reaction_rush